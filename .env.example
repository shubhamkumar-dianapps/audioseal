# Copy this file to .env and fill in the values
# cp .env.example .env

# Django
SECRET_KEY=django-insecure-replace-with-50-char-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=audioseal_db
DB_USER=audioseal_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# AudioSeal ML
AUDIOSEAL_DEVICE=cpu
AUDIOSEAL_MODEL_CARD=audioseal_detector_16bits
WATERMARK_DETECTION_THRESHOLD=0.5
